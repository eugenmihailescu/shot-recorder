{
  "manifest_version": 3,
  "name": "Shot Recorder",
  "version": "0.1.0",
  "description": "Screenshot and screen recording. Runs only when you click it.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "tabCapture", "downloads"],
  "action": {
    "default_title": "Shot Recorder",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "capture-visible": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Capture the visible part of the tab"
    },
    "capture-delay": {
      "description": "Capture the visible part after the delay"
    },
    "capture-full": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Capture the full page"
    },
    "capture-region": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Capture a selected area"
    },
    "capture-desktop": {
      "description": "Capture a screen or application window"
    },
    "record-tab": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Record this tab"
    },
    "record-desktop": {
      "description": "Record the desktop"
    }
  }
}
